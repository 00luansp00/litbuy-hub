NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://litbuy:litbuy_dev_password@localhost:5432/litbuy_dev?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:3001
AUTH_COOKIE_TOPOLOGY=same-host
LOG_LEVEL=info
SWAGGER_ENABLED=true
TRUST_PROXY=false
SERVER_REQUEST_TIMEOUT_MS=60000

POSTGRES_DB=litbuy_dev
POSTGRES_USER=litbuy
POSTGRES_PASSWORD=litbuy_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
AUTH_ACCESS_TOKEN_SECRET=local_access_token_secret_change_me_32_chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_TOKEN_PEPPER=local_refresh_pepper_change_me
AUTH_VERIFICATION_TOKEN_PEPPER=local_verification_pepper_change_me
AUTH_DEVICE_TOKEN_PEPPER=local_device_pepper_change_me
AUTH_CSRF_TOKEN_PEPPER=local_csrf_pepper_change_me
AUTH_IP_HASH_PEPPER=local_ip_hash_pepper_change_me
AUTH_2FA_RECOVERY_PEPPER=<change-me-2fa-recovery-pepper>
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_DEVICE_APPROVAL_TTL_MINUTES=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_REFRESH_COOKIE_NAME=litbuy_refresh
AUTH_DEVICE_COOKIE_NAME=litbuy_device
AUTH_CSRF_COOKIE_NAME=litbuy_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_EMAIL_DELIVERY_MODE=memory
CURRENT_TERMS_VERSION=2026-07-14
CURRENT_PRIVACY_VERSION=2026-07-14
CURRENT_SELLER_AGREEMENT_VERSION=2026-07
AUTH_SMS_DELIVERY_MODE=disabled
AUTH_PHONE_VERIFICATION_TTL_MINUTES=10
AUTH_PHONE_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_CHANGE_TTL_MINUTES=30
AUTH_SENSITIVE_CHANGE_HOLD_HOURS=48

AUTH_2FA_CODE_TTL_MINUTES=10
AUTH_2FA_RESEND_COOLDOWN_SECONDS=60
AUTH_2FA_MAX_ATTEMPTS=5
AUTH_2FA_RECOVERY_CODE_COUNT=10

AUTH_STEP_UP_TOKEN_PEPPER=<change-me>
AUTH_STEP_UP_GRANT_TTL_MINUTES=10
AUTH_STEP_UP_RESEND_COOLDOWN_SECONDS=60
AUTH_STEP_UP_MAX_ATTEMPTS=5
# External auth delivery (required when AUTH_*_DELIVERY_MODE=external)
AUTH_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=LIT Buy
RESEND_REPLY_TO=
AUTH_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
AUTH_EXTERNAL_DELIVERY_TIMEOUT_MS=5000
PRODUCT_IMAGE_S3_ENDPOINT=http://localhost:9000
PRODUCT_IMAGE_S3_SIGNING_ENDPOINT=http://localhost:9000
PRODUCT_IMAGE_S3_REGION=us-east-1
PRODUCT_IMAGE_S3_BUCKET=litbuy-product-images
PRODUCT_IMAGE_S3_ACCESS_KEY=litbuy_test_access
PRODUCT_IMAGE_S3_SECRET_KEY=litbuy_test_secret_only
PRODUCT_IMAGE_S3_FORCE_PATH_STYLE=true
PRODUCT_IMAGE_UPLOAD_URL_TTL_SECONDS=300
PRODUCT_IMAGE_READ_URL_TTL_SECONDS=120
# PRODUCT_IMAGE_PUBLIC_BASE_URL=https://cdn.example.com

MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000

# Efí is disabled by default. Secrets/certificate material belong in a secret manager,
# never in this file or source control. Production remains commercially gated.
EFI_ENABLED=false
EFI_ENVIRONMENT=sandbox
EFI_TIMEOUT_MS=8000
# EFI_CLIENT_ID=
# EFI_CLIENT_SECRET=
# EFI_PIX_MTLS_CERTIFICATE=
# EFI_PIX_MTLS_PRIVATE_KEY=
# EFI_PRODUCTION_APPROVED=false
# Billing callback ingress is separately disabled by default. When enabled, inject a random
# 32-byte base64 key through the secret manager; never copy a real key into this file.
EFI_BILLING_NOTIFICATION_INGRESS_ENABLED=false
# PROVIDER_NOTIFICATION_ENCRYPTION_KEY_ID=notification-key-2026-08
# PROVIDER_NOTIFICATION_ENCRYPTION_KEY_BASE64=
