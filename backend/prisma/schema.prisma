generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  DEVICE_APPROVAL
  PASSWORD_RESET
  PHONE_VERIFICATION
  EMAIL_CHANGE_CURRENT
  EMAIL_CHANGE_NEW
  TWO_FACTOR_ENROLLMENT
  TWO_FACTOR_LOGIN
  TWO_FACTOR_DISABLE
  TWO_FACTOR_STEP_UP
  TWO_FACTOR_METHOD_CHANGE
}

enum TwoFactorMethod {
  EMAIL
  SMS
}

enum PlatformRole {
  BUYER
  SELLER
  ADMIN
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SellerProfileStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SecurityEventType {
  REGISTERED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_LOCKED
  DEVICE_APPROVAL_REQUIRED
  DEVICE_APPROVAL_REQUESTED
  DEVICE_APPROVED
  SESSION_CREATED
  SESSION_REFRESHED
  REFRESH_TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  LOGOUT_ALL
  DEVICE_REVOKED
  PHONE_VERIFICATION_REQUESTED
  PHONE_VERIFIED
  PHONE_CHANGED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGE_CURRENT_CONFIRMED
  EMAIL_CHANGE_NEW_CONFIRMED
  EMAIL_CHANGED
  SENSITIVE_ACTION_HOLD_STARTED
  TWO_FACTOR_ENROLLMENT_REQUESTED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_LOGIN_REQUIRED
  TWO_FACTOR_LOGIN_SUCCEEDED
  TWO_FACTOR_LOGIN_FAILED
  TWO_FACTOR_RECOVERY_CODE_USED
  TWO_FACTOR_DISABLE_REQUESTED
  TWO_FACTOR_DISABLED
  STEP_UP_REQUESTED
  STEP_UP_SUCCEEDED
  STEP_UP_FAILED
  STEP_UP_GRANT_CONSUMED
  TWO_FACTOR_METHOD_CHANGE_REQUESTED
  TWO_FACTOR_METHOD_CHANGED
  TWO_FACTOR_RECOVERY_CODES_REGENERATED
  ROLE_GRANTED
  ROLE_REVOKED
  SELLER_APPLICATION_DRAFT_SAVED
  SELLER_APPLICATION_SUBMITTED
  SELLER_APPLICATION_REVIEW_STARTED
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  SELLER_PROFILE_CREATED
  CATALOG_CATEGORY_CREATED
  CATALOG_CATEGORY_UPDATED
  CATALOG_CATEGORY_STATUS_CHANGED
  CATALOG_SUBCATEGORY_CREATED
  CATALOG_SUBCATEGORY_UPDATED
  CATALOG_SUBCATEGORY_STATUS_CHANGED
  CATALOG_ATTRIBUTE_CREATED
  CATALOG_ATTRIBUTE_UPDATED
  CATALOG_ATTRIBUTE_STATUS_CHANGED
  LISTING_DRAFT_CREATED
  LISTING_DRAFT_UPDATED
  LISTING_DRAFT_SUBMITTED
  LISTING_DRAFT_REVIEW_STARTED
  LISTING_DRAFT_REJECTED
  LISTING_DRAFT_APPROVED
  PRODUCT_MATERIALIZED
  PRODUCT_IMAGE_UPLOAD_INTENT_CREATED
  PRODUCT_IMAGE_UPLOAD_COMPLETED
  PRODUCT_IMAGE_UPLOAD_REJECTED
  PRODUCT_IMAGE_COVER_CHANGED
  PRODUCT_IMAGES_REORDERED
  PRODUCT_IMAGE_DELETED
  PRODUCT_ACTIVATED
  PRODUCT_PAUSED
  PRODUCT_RESUMED
  PRODUCT_REMOVED
  PRODUCT_AUTO_PAUSED_OUT_OF_STOCK
  PRODUCT_INVENTORY_RESTOCKED
  PRODUCT_AUTO_RESUMED_AFTER_RESTOCK
  CART_CREATED
  CART_ITEM_ADDED
  CART_ITEM_UPDATED
  CART_ITEM_REMOVED
  CHECKOUT_ORDER_CREATED
  ORDER_CANCELLED
  ORDER_EXPIRED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
  CHARGEBACK
}

enum PaymentStatus {
  NOT_CREATED
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  CHARGEBACK
}

enum FulfillmentStatus {
  NOT_AVAILABLE
  AWAITING_SELLER
  DELIVERED
  AWAITING_BUYER_CONFIRMATION
  CONFIRMED
}

enum DisputeStatus {
  NONE
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum DisputeCaseStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum DisputeFinancialDecisionType {
  TOTAL
  PARTIAL
}

enum DisputeCaseEventType {
  CASE_OPENED
  STATUS_CHANGED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum CommerceIdempotencyOperation {
  CHECKOUT_CREATE
  ORDER_CANCEL
  SELLER_MAX_RESTOCK
  BUYER_REPORT_PROBLEM
}

enum OrderEventType {
  ORDER_CREATED
  INVENTORY_RESERVED
  ORDER_ACTIVATED
  INVENTORY_CONSUMED
  ORDER_CANCELLED
  INVENTORY_RELEASED
  ORDER_EXPIRED
  FULFILLMENT_AVAILABLE
  FULFILLMENT_DELIVERED
  FULFILLMENT_AWAITING_BUYER_CONFIRMATION
  FULFILLMENT_CONFIRMED
  ORDER_COMPLETED
  SELLER_MAX_QUALIFICATION_STARTED
  SELLER_MAX_QUALIFIED
  SELLER_MAX_QUALIFICATION_EXPIRED
}

enum SellerMaxQualificationStatus {
  PENDING
  QUALIFIED
  EXPIRED
}

enum OrderDeliveryType {
  MANUAL_REFERENCE
  AUTOMATED_REFERENCE
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum StepUpScope {
  TWO_FACTOR_METHOD_CHANGE
  TWO_FACTOR_RECOVERY_REGENERATE
}

enum StepUpAssurance {
  TWO_FACTOR
  RECOVERY_CODE
}

enum SecurityEventOutcome {
  SUCCESS
  FAILURE
  BLOCKED
  PENDING
  CRITICAL
}

model User {
  id                               String                       @id @default(uuid()) @db.Uuid
  email                            String                       @unique
  phoneE164                        String?
  phoneVerifiedAt                  DateTime?
  birthDate                        DateTime                     @db.Date
  status                           UserStatus                   @default(PENDING_EMAIL)
  emailVerifiedAt                  DateTime?
  termsVersion                     String
  termsAcceptedAt                  DateTime
  privacyVersion                   String
  privacyAcceptedAt                DateTime
  createdAt                        DateTime                     @default(now())
  updatedAt                        DateTime                     @updatedAt
  deletedAt                        DateTime?
  sensitiveActionHoldUntil         DateTime?
  lastSensitiveChangeAt            DateTime?
  passwordCredential               PasswordCredential?
  devices                          Device[]
  sessions                         Session[]
  verificationChallenges           VerificationChallenge[]
  securityEvents                   SecurityEvent[]
  emailChangeRequests              EmailChangeRequest[]
  twoFactorSettings                TwoFactorSettings?
  twoFactorRecoveryCodes           TwoFactorRecoveryCode[]
  stepUpGrants                     StepUpGrant[]
  roleAssignments                  UserRoleAssignment[]
  sellerApplication                SellerApplication?           @relation("SellerApplicationOwner")
  reviewedSellerApplications       SellerApplication[]          @relation("SellerApplicationReviewer")
  sellerProfile                    SellerProfile?
  reviewedListingDrafts            ListingDraft[]               @relation("ListingDraftReviewer")
  carts                            Cart[]                       @relation("CartBuyer")
  orders                           Order[]                      @relation("OrderBuyer")
  commerceIdempotencyRecords       CommerceIdempotencyRecord[]
  reviewedWithdrawals              Withdrawal[]                 @relation("WithdrawalReviewer")
  createdFeePolicies               FeePolicyVersion[]           @relation("FeePolicyCreator")
  publishedFeePolicies             FeePolicyVersion[]           @relation("FeePolicyPublisher")
  createdWithdrawalPolicies        WithdrawalPolicyVersion[]    @relation("WithdrawalPolicyCreator")
  publishedWithdrawalPolicies      WithdrawalPolicyVersion[]    @relation("WithdrawalPolicyPublisher")
  createdSellerReleasePolicies     SellerReleasePolicyVersion[] @relation("SellerReleasePolicyCreator")
  publishedSellerReleasePolicies   SellerReleasePolicyVersion[] @relation("SellerReleasePolicyPublisher")
  financialEvents                  FinancialEvent[]             @relation("FinancialEventActor")
  requestedRefunds                 Refund[]                     @relation("RefundRequester")
  sentOrderChatMessages            OrderChatMessage[]           @relation("OrderChatMessageSender")
  litPointsTransactions            LitPointsLedgerTransaction[]
  litPointsEntries                 LitPointsLedgerEntry[]
  disputeCaseEvents                DisputeCaseEvent[]           @relation("DisputeCaseEventActor")
  createdDisputeFinancialDecisions DisputeFinancialDecision[]   @relation("DisputeFinancialDecisionCreator")
  buyerDisputeFinancialDecisions   DisputeFinancialDecision[]   @relation("DisputeFinancialDecisionBuyer")
  buyerDisputeSellerLiabilities    DisputeSellerLiability[]     @relation("DisputeSellerLiabilityBuyer")

  @@unique([phoneE164])
  @@index([email])
  @@index([status])
}

model UserRoleAssignment {
  userId    String       @db.Uuid
  role      PlatformRole
  grantedAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model SellerApplication {
  id                        String                  @id @default(uuid()) @db.Uuid
  userId                    String                  @unique @db.Uuid
  storeName                 String
  requestedSlug             String
  description               String?
  status                    SellerApplicationStatus @default(DRAFT)
  sellerAgreementVersion    String?
  sellerAgreementAcceptedAt DateTime?
  submittedAt               DateTime?
  reviewedAt                DateTime?
  reviewedByUserId          String?                 @db.Uuid
  rejectionCode             String?
  rejectionReason           String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  user       User  @relation("SellerApplicationOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("SellerApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([requestedSlug])
}

model SellerProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @db.Uuid
  storeName   String
  slug        String              @unique
  description String?
  status      SellerProfileStatus @default(ACTIVE)
  verified    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  listingDrafts             ListingDraft[]
  products                  Product[]
  carts                     Cart[]
  orders                    Order[]
  paymentProviderAccounts   PaymentProviderAccount[]
  ledgerAccounts            LedgerAccount[]
  financialHolds            FinancialHold[]
  sellerPendingHoldZeros    SellerPendingHoldZero[]
  withdrawals               Withdrawal[]
  orderDeliveries           OrderDelivery[]
  disputeFinancialDecisions DisputeFinancialDecision[]
  disputeSellerLiabilities  DisputeSellerLiability[]

  @@index([status])
  @@index([slug])
}

model PasswordCredential {
  userId              String    @id @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  passwordHash        String
  passwordChangedAt   DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Device {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash              String                  @unique
  displayName            String?
  userAgent              String?
  status                 DeviceStatus            @default(PENDING)
  isInitialDevice        Boolean                 @default(false)
  approvedAt             DateTime?
  firstSeenAt            DateTime                @default(now())
  lastSeenAt             DateTime                @default(now())
  revokedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  verificationChallenges VerificationChallenge[]
  securityEvents         SecurityEvent[]
  stepUpGrants           StepUpGrant[]

  @@index([userId])
  @@index([tokenHash])
  @@index([userId, status])
}

model Session {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  deviceId             String                @db.Uuid
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  device               Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  refreshTokenHash     String                @unique
  refreshTokenFamilyId String                @db.Uuid
  csrfTokenHash        String
  expiresAt            DateTime
  lastUsedAt           DateTime              @default(now())
  revokedAt            DateTime?
  revocationReason     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  securityEvents       SecurityEvent[]
  refreshTokens        SessionRefreshToken[]
  stepUpGrants         StepUpGrant[]

  @@index([userId])
  @@index([deviceId])
  @@index([refreshTokenHash])
  @@index([refreshTokenFamilyId])
  @@index([revokedAt, expiresAt])
}

model VerificationChallenge {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  deviceId    String?             @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  device      Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  purpose     VerificationPurpose
  tokenHash   String              @unique
  targetHash  String?
  contextId   String?             @db.Uuid
  attempts    Int                 @default(0)
  maxAttempts Int
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([purpose])
  @@index([targetHash])
  @@index([contextId])
  @@index([purpose, consumedAt, expiresAt])
}

model EmailChangeRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  newEmailHash            String
  expiresAt               DateTime
  currentEmailConfirmedAt DateTime?
  newEmailConfirmedAt     DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@index([newEmailHash])
  @@index([completedAt, cancelledAt, expiresAt])
}

model SecurityEvent {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String?              @db.Uuid
  sessionId String?              @db.Uuid
  deviceId  String?              @db.Uuid
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  session   Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  device    Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  eventType SecurityEventType
  outcome   SecurityEventOutcome
  metadata  Json                 @default("{}")
  ipHash    String?
  userAgent String?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model SessionRefreshToken {
  id                String                @id @default(uuid()) @db.Uuid
  sessionId         String                @db.Uuid
  familyId          String                @db.Uuid
  session           Session               @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash         String                @unique
  expiresAt         DateTime
  issuedAt          DateTime              @default(now())
  usedAt            DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?               @db.Uuid
  replacedByToken   SessionRefreshToken?  @relation("RefreshReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          SessionRefreshToken[] @relation("RefreshReplacement")
  createdAt         DateTime              @default(now())

  @@index([sessionId])
  @@index([familyId])
  @@index([tokenHash])
  @@index([familyId, revokedAt, expiresAt])
}

model TwoFactorSettings {
  userId     String          @id @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  method     TwoFactorMethod
  enabledAt  DateTime
  disabledAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([disabledAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model StepUpGrant {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  sessionId  String          @db.Uuid
  deviceId   String          @db.Uuid
  scope      StepUpScope
  assurance  StepUpAssurance
  tokenHash  String          @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  session    Session         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  device     Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sessionId, scope])
  @@index([deviceId])
  @@index([tokenHash])
  @@index([expiresAt, consumedAt, revokedAt])
}

enum CatalogEntityStatus {
  ACTIVE
  INACTIVE
}

enum CatalogProductType {
  ACCOUNT
  VIRTUAL_CURRENCY
  GIFT_CARD
  KEY
  SKIN
  ITEM
  SERVICE
  SUBSCRIPTION
  GAME
  SOFTWARE
  OTHER
}

enum CatalogAttributeInputType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

model CatalogCategory {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  name        String
  description String?
  iconKey     String?
  colorHex    String?
  sortOrder   Int                 @default(0)
  featured    Boolean             @default(false)
  status      CatalogEntityStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  subcategories             CatalogSubcategory[]
  listingDrafts             ListingDraft[]
  products                  Product[]
  sellerReleasePolicyRules  SellerReleasePolicyRule[]
  sellerReleasePolicyOrders Order[]                   @relation("OrderSellerReleasePolicyCategory")

  @@index([status, sortOrder])
  @@index([featured, status, sortOrder])
}

model CatalogSubcategory {
  id         String              @id @default(uuid()) @db.Uuid
  categoryId String              @db.Uuid
  slug       String
  name       String
  sortOrder  Int                 @default(0)
  status     CatalogEntityStatus @default(ACTIVE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  category                  CatalogCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes                CatalogAttribute[]
  listingDrafts             ListingDraft[]
  products                  Product[]
  sellerReleasePolicyRules  SellerReleasePolicyRule[]
  sellerReleasePolicyOrders Order[]                   @relation("OrderSellerReleasePolicySubcategory")

  @@unique([categoryId, slug])
  @@index([categoryId, status, sortOrder])
}

model CatalogAttribute {
  id            String                    @id @default(uuid()) @db.Uuid
  subcategoryId String?                   @db.Uuid
  productType   CatalogProductType?
  key           String
  label         String
  inputType     CatalogAttributeInputType
  placeholder   String?
  required      Boolean                   @default(false)
  selectOptions String[]                  @default([])
  sortOrder     Int                       @default(0)
  status        CatalogEntityStatus       @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  subcategory CatalogSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  @@index([subcategoryId, status, sortOrder])
  @@index([productType, status, sortOrder])
}

enum ListingDraftStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  REJECTED
  APPROVED
}

enum ListingDraftModel {
  NORMAL
  DYNAMIC
  SERVICE
}

enum ListingDraftDeliveryMode {
  MANUAL
  AUTOMATIC
}

enum ListingDraftPromotionPreference {
  SILVER
  GOLD
  DIAMOND
}

enum ListingDraftSellerPlanPreference {
  STANDARD
  LIT_MAX
}

enum BuyerVipPlan {
  NONE
  BASIC
  PREMIUM
}

enum ListingDraftServicePricingType {
  FIXED
  QUOTE
}

enum ListingDraftVariantStatus {
  ACTIVE
  PAUSED
}

enum ListingDraftAccountProvenance {
  ORIGINAL_OWNER
  RESELLER
  THIRD_PARTY
  OTHER
}

enum ListingDraftAccountRecoveryLevel {
  FULL
  PARTIAL
  NONE
  UNKNOWN
}

enum ListingDraftAccountRecoveryRisk {
  LOW
  MEDIUM
  HIGH
}

model ListingDraft {
  id                     String                           @id @default(uuid()) @db.Uuid
  sellerProfileId        String                           @db.Uuid
  categoryId             String?                          @db.Uuid
  subcategoryId          String?                          @db.Uuid
  productType            CatalogProductType?
  model                  ListingDraftModel                @default(NORMAL)
  status                 ListingDraftStatus               @default(DRAFT)
  title                  String?
  description            String?
  price                  Decimal?                         @db.Decimal(12, 2)
  stock                  Int?
  deliveryMode           ListingDraftDeliveryMode         @default(MANUAL)
  requestedPromotionTier ListingDraftPromotionPreference?
  requestedSellerPlan    ListingDraftSellerPlanPreference @default(STANDARD)
  autoMessage            String?
  notifyInApp            Boolean                          @default(true)
  notifyBrowser          Boolean                          @default(false)
  notifyEmailFuture      Boolean                          @default(false)
  notifyExternalFuture   Boolean                          @default(false)
  wizardStep             Int                              @default(1)
  version                Int                              @default(1)
  submittedAt            DateTime?
  reviewStartedAt        DateTime?
  reviewedAt             DateTime?
  reviewedByUserId       String?                          @db.Uuid
  rejectionCode          String?
  rejectionReason        String?
  approvedAt             DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  sellerProfile          SellerProfile                    @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  category               CatalogCategory?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory            CatalogSubcategory?              @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  reviewedBy             User?                            @relation("ListingDraftReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  variants               ListingDraftVariant[]
  attributes             ListingDraftAttributeValue[]
  serviceDetails         ListingDraftServiceDetails?
  accountDetails         ListingDraftAccountDetails?
  materializedProduct    Product?

  @@index([sellerProfileId, status, updatedAt])
  @@index([status, submittedAt])
  @@index([categoryId, subcategoryId])
}

model ListingDraftVariant {
  id          String                    @id @default(uuid()) @db.Uuid
  draftId     String                    @db.Uuid
  title       String
  description String?
  price       Decimal                   @db.Decimal(12, 2)
  stock       Int
  status      ListingDraftVariantStatus @default(ACTIVE)
  sortOrder   Int                       @default(0)
  draft       ListingDraft              @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, sortOrder])
}

model ListingDraftAttributeValue {
  draftId String       @db.Uuid
  key     String
  value   String
  draft   ListingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@id([draftId, key])
}

model ListingDraftServiceDetails {
  draftId           String                          @id @db.Uuid
  title             String?
  description       String?
  pricingType       ListingDraftServicePricingType?
  basePrice         Decimal?                        @db.Decimal(12, 2)
  estimatedDelivery String?
  buyerRequirements String?
  notes             String?
  draft             ListingDraft                    @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model ListingDraftAccountDetails {
  draftId        String                            @id @db.Uuid
  provenance     ListingDraftAccountProvenance?
  recoveryLevel  ListingDraftAccountRecoveryLevel?
  emailVerified  Boolean?
  phoneLinked    Boolean?
  documentLinked Boolean?
  fullAccess     Boolean?
  recoveryRisk   ListingDraftAccountRecoveryRisk?
  warrantyNote   String?
  draft          ListingDraft                      @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

enum ProductStatus {
  UNPUBLISHED
  ACTIVE
  PAUSED
  REMOVED
}

enum ProductPauseReason {
  SELLER_MAX_OUT_OF_STOCK
}

enum ProductVariantStatus {
  ACTIVE
  PAUSED
}

enum ProductImageStatus {
  PENDING_UPLOAD
  READY
  DELETED
}

model Product {
  id                   String                           @id @default(uuid()) @db.Uuid
  sourceListingDraftId String                           @unique @db.Uuid
  sellerProfileId      String                           @db.Uuid
  categoryId           String                           @db.Uuid
  subcategoryId        String?                          @db.Uuid
  productType          CatalogProductType
  model                ListingDraftModel
  status               ProductStatus                    @default(UNPUBLISHED)
  pauseReason          ProductPauseReason?
  slug                 String                           @unique
  title                String
  description          String
  price                Decimal?                         @db.Decimal(12, 2)
  stock                Int?
  deliveryMode         ListingDraftDeliveryMode         @default(MANUAL)
  listingTier          ListingDraftPromotionPreference
  sellerPlan           ListingDraftSellerPlanPreference @default(STANDARD)
  autoMessage          String?
  version              Int                              @default(1)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  sourceListingDraft    ListingDraft            @relation(fields: [sourceListingDraftId], references: [id], onDelete: Restrict)
  sellerProfile         SellerProfile           @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  category              CatalogCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory           CatalogSubcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  attributes            ProductAttributeValue[]
  serviceDetails        ProductServiceDetails?
  accountDetails        ProductAccountDetails?
  images                ProductImage[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@index([sellerProfileId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([categoryId, subcategoryId])
}

model ProductImage {
  id              String             @id @default(uuid()) @db.Uuid
  productId       String             @db.Uuid
  objectKey       String             @unique
  status          ProductImageStatus @default(PENDING_UPLOAD)
  contentType     String
  sizeBytes       Int
  altText         String?
  sortOrder       Int
  isCover         Boolean            @default(false)
  uploadedAt      DateTime?
  uploadExpiresAt DateTime
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status, sortOrder])
  @@index([productId, status, uploadExpiresAt])
}

model ProductVariant {
  id                    String                 @id @default(uuid()) @db.Uuid
  productId             String                 @db.Uuid
  title                 String
  description           String?
  price                 Decimal?               @db.Decimal(12, 2)
  stock                 Int?
  status                ProductVariantStatus   @default(ACTIVE)
  sortOrder             Int                    @default(0)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@unique([id, productId])
  @@index([productId, sortOrder])
  @@index([productId, status])
}

model Cart {
  id              String     @id @default(uuid()) @db.Uuid
  buyerUserId     String     @db.Uuid
  sellerProfileId String     @db.Uuid
  status          CartStatus @default(ACTIVE)
  version         Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  checkedOutAt    DateTime?

  buyer         User          @relation("CartBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items         CartItem[]
  order         Order?

  @@index([buyerUserId, updatedAt, id])
  @@index([sellerProfileId, status])
}

model Order {
  id                                 String                            @id @default(uuid()) @db.Uuid
  publicCode                         String                            @unique
  sourceCartId                       String                            @unique @db.Uuid
  sourceCartVersion                  Int
  buyerUserId                        String                            @db.Uuid
  sellerProfileId                    String                            @db.Uuid
  currency                           String                            @default("BRL")
  subtotalAmountMinor                BigInt
  discountAmountMinor                BigInt                            @default(0)
  platformFeeAmountMinor             BigInt                            @default(0)
  totalAmountMinor                   BigInt
  status                             OrderStatus                       @default(PENDING_PAYMENT)
  paymentStatus                      PaymentStatus                     @default(NOT_CREATED)
  fulfillmentStatus                  FulfillmentStatus                 @default(NOT_AVAILABLE)
  disputeStatus                      DisputeStatus                     @default(NONE)
  version                            Int                               @default(1)
  pricingPolicyVersion               Int                               @default(1)
  feePolicyVersionId                 String?                           @db.Uuid
  platformCommissionRuleId           String?                           @db.Uuid
  feeSnapshotVersion                 Int?
  commercialSnapshotVersion          Int?
  sellerPlanSnapshot                 ListingDraftSellerPlanPreference?
  buyerVipSelectionVersion           Int?
  buyerVipPlanSnapshot               BuyerVipPlan?
  sellerMaxQualificationVersion      Int?
  sellerMaxQualificationStatus       SellerMaxQualificationStatus?
  sellerMaxQualificationDeadlineAt   DateTime?
  sellerMaxQualificationDecidedAt    DateTime?
  buyerConfirmedAt                   DateTime?
  sellerMaxReleaseCalculationVersion Int?
  sellerMaxReleaseReductionHours     Int?
  sellerMaxReleaseTargetAt           DateTime?
  sellerMaxEffectiveReleaseAt        DateTime?
  sellerReleasePolicyVersionId       String?                           @db.Uuid
  sellerReleasePolicyRuleId          String?                           @db.Uuid
  sellerReleasePolicySource          SellerReleasePolicyScope?
  sellerReleasePolicyCategoryId      String?                           @db.Uuid
  sellerReleasePolicySubcategoryId   String?                           @db.Uuid
  frozenBaseReleaseDelayHours        Int?
  expiresAt                          DateTime
  cancelledAt                        DateTime?
  expiredAt                          DateTime?
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  sourceCart                         Cart                              @relation(fields: [sourceCartId], references: [id], onDelete: Restrict)
  buyer                              User                              @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerProfile                      SellerProfile                     @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items                              OrderItem[]
  reservations                       InventoryReservation[]
  events                             OrderEvent[]
  payment                            Payment?
  delivery                           OrderDelivery?
  financialHolds                     FinancialHold[]
  sellerPendingHoldZero              SellerPendingHoldZero?
  refunds                            Refund[]
  feePolicyVersion                   FeePolicyVersion?                 @relation(fields: [feePolicyVersionId], references: [id], onDelete: Restrict)
  platformCommissionRule             FeeRule?                          @relation("OrderPlatformCommissionRule", fields: [platformCommissionRuleId, feePolicyVersionId], references: [id, policyVersionId], onDelete: Restrict)
  feeComponentSnapshots              OrderFeeComponentSnapshot[]
  sellerReleasePolicyVersion         SellerReleasePolicyVersion?       @relation(fields: [sellerReleasePolicyVersionId], references: [id], onDelete: Restrict)
  sellerReleasePolicyRule            SellerReleasePolicyRule?          @relation(fields: [sellerReleasePolicyRuleId, sellerReleasePolicyVersionId], references: [id, policyVersionId], onDelete: Restrict)
  sellerReleasePolicyCategory        CatalogCategory?                  @relation("OrderSellerReleasePolicyCategory", fields: [sellerReleasePolicyCategoryId], references: [id], onDelete: Restrict)
  sellerReleasePolicySubcategory     CatalogSubcategory?               @relation("OrderSellerReleasePolicySubcategory", fields: [sellerReleasePolicySubcategoryId], references: [id], onDelete: Restrict)
  chatConversation                   OrderChatConversation?
  disputeCases                       DisputeCase[]
  disputeFinancialDecisions          DisputeFinancialDecision[]
  disputeSellerLiabilities           DisputeSellerLiability[]

  @@unique([id, sellerProfileId])
  @@index([buyerUserId, createdAt, id])
  @@index([sellerProfileId, createdAt, id])
  @@index([status, expiresAt])
  @@index([feePolicyVersionId])
  @@index([platformCommissionRuleId])
  @@index([sellerReleasePolicyVersionId])
  @@index([sellerReleasePolicyRuleId])
  @@index([sellerReleasePolicyCategoryId])
  @@index([sellerReleasePolicySubcategoryId])
  @@index([sellerMaxQualificationStatus, sellerMaxQualificationDeadlineAt])
}

model DisputeCase {
  id                String                    @id @default(uuid()) @db.Uuid
  orderId           String                    @db.Uuid
  status            DisputeCaseStatus         @default(OPEN)
  mutationActorId   String?                   @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now())
  terminalAt        DateTime?
  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            DisputeCaseEvent[]
  financialDecision DisputeFinancialDecision?
  sellerLiability   DisputeSellerLiability?

  @@unique([id, orderId])
  @@index([orderId, createdAt, id])
}

model DisputeFinancialDecision {
  id                          String                       @id @default(uuid()) @db.Uuid
  disputeCaseId               String                       @unique @db.Uuid
  orderId                     String                       @db.Uuid
  buyerUserId                 String                       @db.Uuid
  sellerProfileId             String                       @db.Uuid
  decisionType                DisputeFinancialDecisionType
  orderPrincipalSnapshotMinor BigInt
  decidedPrincipalAmountMinor BigInt
  currency                    String                       @default("BRL")
  executableAt                DateTime                     @default(now())
  createdByUserId             String                       @db.Uuid
  idempotencyKeyHash          String
  requestHash                 String
  createdAt                   DateTime                     @default(now())
  disputeCase                 DisputeCase                  @relation(fields: [disputeCaseId, orderId], references: [id, orderId], onDelete: Restrict)
  order                       Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer                       User                         @relation("DisputeFinancialDecisionBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerProfile               SellerProfile                @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  createdBy                   User                         @relation("DisputeFinancialDecisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sellerLiability             DisputeSellerLiability?

  @@unique([createdByUserId, idempotencyKeyHash])
  @@unique([disputeCaseId, orderId])
  @@index([sellerProfileId, executableAt, id])
  @@index([orderId, executableAt, id])
}

model DisputeSellerLiability {
  id                                             String                               @id @default(uuid()) @db.Uuid
  disputeFinancialDecisionId                     String                               @unique @db.Uuid
  disputeCaseId                                  String                               @unique @db.Uuid
  orderId                                        String                               @db.Uuid
  buyerUserId                                    String                               @db.Uuid
  sellerProfileId                                String                               @db.Uuid
  decisionPrincipalAmountMinor                   BigInt
  reversiblePlatformSellerFeeRequiredAmountMinor BigInt
  sellerLiabilityAmountMinor                     BigInt
  currency                                       String                               @default("BRL")
  createdAt                                      DateTime                             @default(now())
  financialDecision                              DisputeFinancialDecision             @relation(fields: [disputeFinancialDecisionId], references: [id], onDelete: Restrict)
  disputeCase                                    DisputeCase                          @relation(fields: [disputeCaseId], references: [id], onDelete: Restrict)
  order                                          Order                                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer                                          User                                 @relation("DisputeSellerLiabilityBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerProfile                                  SellerProfile                        @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  feeComponents                                  DisputeSellerLiabilityFeeComponent[]

  @@index([orderId, createdAt, id])
  @@index([sellerProfileId, createdAt, id])
}

model DisputeSellerLiabilityFeeComponent {
  id                           String                    @id @default(uuid()) @db.Uuid
  disputeSellerLiabilityId     String                    @db.Uuid
  orderFeeComponentSnapshotId  String                    @db.Uuid
  componentKind                OrderFeeComponentKind
  originalFrozenFeeAmountMinor BigInt
  reversalRequiredAmountMinor  BigInt
  createdAt                    DateTime                  @default(now())
  liability                    DisputeSellerLiability    @relation(fields: [disputeSellerLiabilityId], references: [id], onDelete: Restrict)
  orderFeeComponentSnapshot    OrderFeeComponentSnapshot @relation(fields: [orderFeeComponentSnapshotId], references: [id], onDelete: Restrict)

  @@unique([disputeSellerLiabilityId, orderFeeComponentSnapshotId])
}

model DisputeCaseEvent {
  id            String               @id @default(uuid()) @db.Uuid
  disputeCaseId String               @db.Uuid
  orderId       String               @db.Uuid
  type          DisputeCaseEventType
  fromStatus    DisputeCaseStatus?
  toStatus      DisputeCaseStatus
  actorUserId   String?              @db.Uuid
  createdAt     DateTime             @default(now())
  disputeCase   DisputeCase          @relation(fields: [disputeCaseId, orderId], references: [id, orderId], onDelete: Restrict)
  actor         User?                @relation("DisputeCaseEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([disputeCaseId, createdAt, id])
  @@index([orderId, createdAt, id])
}

model OrderFeeComponentSnapshot {
  id                                  String                               @id @default(uuid()) @db.Uuid
  orderId                             String                               @db.Uuid
  componentKind                       OrderFeeComponentKind
  feePolicyVersionId                  String                               @db.Uuid
  feeRuleId                           String                               @db.Uuid
  pricingPolicyVersion                Int
  listingTier                         ListingDraftPromotionPreference?
  sellerPlan                          ListingDraftSellerPlanPreference?
  buyerVipPlan                        BuyerVipPlan?
  category                            FeeRuleCategory
  partyCharged                        FeeParty
  formula                             FeeFormula
  percentBps                          Int
  baseAmountMinor                     BigInt
  feeAmountMinor                      BigInt
  currency                            String
  createdAt                           DateTime                             @default(now())
  order                               Order                                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  feePolicyVersion                    FeePolicyVersion                     @relation(fields: [feePolicyVersionId], references: [id], onDelete: Restrict)
  feeRule                             FeeRule                              @relation(fields: [feeRuleId, feePolicyVersionId], references: [id, policyVersionId], onDelete: Restrict)
  disputeSellerLiabilityFeeComponents DisputeSellerLiabilityFeeComponent[]

  @@unique([orderId, componentKind])
  @@index([feePolicyVersionId])
  @@index([feeRuleId])
}

model OrderChatConversation {
  id            String             @id @default(uuid()) @db.Uuid
  orderId       String             @unique @db.Uuid
  createdAt     DateTime           @default(now())
  lastMessageAt DateTime?
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  messages      OrderChatMessage[]
}

model OrderChatMessage {
  id              String                @id @default(uuid()) @db.Uuid
  conversationId  String                @db.Uuid
  senderUserId    String                @db.Uuid
  clientMessageId String                @db.Uuid
  body            String                @db.Text
  createdAt       DateTime              @default(now())
  conversation    OrderChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender          User                  @relation("OrderChatMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderUserId])
}

model OrderDelivery {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @unique @db.Uuid
  sellerProfileId String            @db.Uuid
  deliveryType    OrderDeliveryType
  evidenceHash    String
  secureReference String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId, sellerProfileId], references: [id, sellerProfileId], onDelete: Restrict)
  sellerProfile   SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@unique([orderId, sellerProfileId])
  @@index([sellerProfileId, createdAt])
}

model OrderItem {
  id                       String                   @id @default(uuid()) @db.Uuid
  orderId                  String                   @db.Uuid
  sourceProductId          String                   @db.Uuid
  sourceProductVersion     Int
  sourceProductVariantId   String?                  @db.Uuid
  sellerProfileId          String                   @db.Uuid
  sellerStoreName          String
  sellerSlug               String
  productSlug              String
  productTitle             String
  variantTitle             String?
  productType              CatalogProductType
  productModel             ListingDraftModel
  deliveryMode             ListingDraftDeliveryMode
  unitAmountMinor          BigInt
  quantity                 Int
  lineTotalAmountMinor     BigInt
  currency                 String                   @default("BRL")
  serviceEstimatedDelivery String?
  serviceBuyerRequirements String?
  pricingPolicyVersion     Int                      @default(1)
  createdAt                DateTime                 @default(now())
  order                    Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceProduct            Product                  @relation(fields: [sourceProductId], references: [id], onDelete: Restrict)
  sourceProductVariant     ProductVariant?          @relation(fields: [sourceProductVariantId, sourceProductId], references: [id, productId], onDelete: Restrict)
  reservation              InventoryReservation?

  @@unique([orderId], map: "OrderItem_orderId_key")
}

model InventoryReservation {
  id               String                     @id @default(uuid()) @db.Uuid
  orderId          String                     @db.Uuid
  orderItemId      String                     @unique @db.Uuid
  productId        String                     @db.Uuid
  productVariantId String?                    @db.Uuid
  quantity         Int
  status           InventoryReservationStatus @default(ACTIVE)
  expiresAt        DateTime
  releasedAt       DateTime?
  consumedAt       DateTime?
  releaseReason    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem        OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product          Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant?            @relation(fields: [productVariantId, productId], references: [id, productId], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([productId, status, expiresAt])
  @@index([productVariantId, status, expiresAt])
}

model CommerceIdempotencyRecord {
  id             String                       @id @default(uuid()) @db.Uuid
  actorUserId    String                       @db.Uuid
  operation      CommerceIdempotencyOperation
  keyHash        String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  resourceType   String?
  resourceId     String?                      @db.Uuid
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime                     @default(now())
  actor          User                         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, operation, keyHash])
}

model OrderEvent {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @db.Uuid
  type        OrderEventType
  actorUserId String?        @db.Uuid
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  outbox      OutboxEvent?

  @@index([orderId, createdAt])
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  orderEventId  String            @unique @db.Uuid
  aggregateType String
  aggregateId   String            @db.Uuid
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  publishedAt   DateTime?
  lastErrorCode String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orderEvent    OrderEvent        @relation(fields: [orderEventId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String?  @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [productVariantId, productId], references: [id, productId], onDelete: Restrict)

  @@unique([cartId], map: "CartItem_cartId_key")
  @@index([productId])
  @@index([productVariantId, productId])
}

model ProductAttributeValue {
  productId String  @db.Uuid
  key       String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([productId, key])
}

model ProductServiceDetails {
  productId         String                         @id @db.Uuid
  pricingType       ListingDraftServicePricingType
  basePrice         Decimal?                       @db.Decimal(12, 2)
  estimatedDelivery String?
  buyerRequirements String?
  notes             String?
  product           Product                        @relation(fields: [productId], references: [id], onDelete: Restrict)
