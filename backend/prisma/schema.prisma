  RETIRED
}

enum SellerReleasePolicyStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  RETIRED
}

enum SellerReleasePolicyScope {
  DEFAULT
  CATEGORY
  SUBCATEGORY
}

model Payment {
  id                    String                 @id @default(uuid()) @db.Uuid
  orderId               String                 @unique @db.Uuid
  amountMinor           BigInt
  currency              String                 @default("BRL")
  status                PaymentStatus          @default(PENDING)
  paidAt                DateTime?
  version               Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attempts              PaymentAttempt[]
  refunds               Refund[]
  settlements           Settlement[]
  chargebacks           Chargeback[]
  holds                 FinancialHold[]
  sellerPendingHoldZero SellerPendingHoldZero?
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([id, orderId])
}

model PaymentProviderAccount {
  id                String                @id @default(uuid()) @db.Uuid
  providerCode      String
  owner             ProviderAccountOwner
  sellerProfileId   String?               @db.Uuid
  externalAccountId String
  status            ProviderAccountStatus @default(PENDING_ONBOARDING)
  providerStatusRaw String?
  secretRef         String?
  canCreateCharges  Boolean               @default(false)
  canReceive        Boolean               @default(false)
  canSplit          Boolean               @default(false)
  canUseHold        Boolean               @default(false)
  canWithdraw       Boolean               @default(false)
  canRefund         Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  attempts          PaymentAttempt[]
  withdrawals       Withdrawal[]
  sellerProfile     SellerProfile?        @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@unique([providerCode, externalAccountId])
  @@index([sellerProfileId, status])
}

model PaymentAttempt {
  id                 String                  @id @default(uuid()) @db.Uuid
  paymentId          String                  @db.Uuid
  attemptNumber      Int
  providerCode       String
  providerAccountId  String?                 @db.Uuid
  method             PaymentMethod?
  status             PaymentAttemptStatus    @default(CREATED)
  amountMinor        BigInt
  currency           String                  @default("BRL")
  externalPaymentId  String?
  externalAttemptId  String?
  providerStatusRaw  String?
  idempotencyKeyHash String
  requestHash        String
  expiresAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  payment            Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerAccount    PaymentProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@unique([providerCode, externalPaymentId])
  @@unique([providerCode, externalAttemptId])
  @@unique([providerCode, idempotencyKeyHash])
}

model LedgerAccount {
  id              String               @id @default(uuid()) @db.Uuid
  ownerType       LedgerOwnerType
  ownerId         String
  sellerProfileId String?              @db.Uuid
  accountClass    LedgerAccountClass
  purpose         LedgerAccountPurpose
  currency        String               @default("BRL")
  createdAt       DateTime             @default(now())
  entries         LedgerEntry[]
  sellerProfile   SellerProfile?       @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@unique([ownerType, ownerId, purpose, currency])
}

model LedgerTransaction {
  id                       String          @id @default(uuid()) @db.Uuid
  currency                 String          @default("BRL")
  type                     String
  referenceType            String?
  referenceId              String?         @db.Uuid
  idempotencyKeyHash       String          @unique
  requestHash              String
  reversalOfId             String?         @db.Uuid
  metadata                 Json            @default("{}")
  createdAt                DateTime        @default(now())
  entries                  LedgerEntry[]
  financialEvent           FinancialEvent?
  originatingFinancialHold FinancialHold?  @relation("FinancialHoldOriginatingTransaction")
  releasedFinancialHold    FinancialHold?  @relation("FinancialHoldReleaseTransaction")
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  accountId     String            @db.Uuid
  direction     LedgerDirection
  amountMinor   BigInt
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
}

model LitPointsLedgerTransaction {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @db.Uuid
  operationKey    String                 @unique
  operation       String
  source          String
  sourceReference String
  requestHash     String
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries         LitPointsLedgerEntry[]

  @@unique([id, userId])
  @@index([userId, createdAt, id])
}

model LitPointsLedgerEntry {
  id            String                     @id @default(uuid()) @db.Uuid
  transactionId String                     @db.Uuid
  userId        String                     @db.Uuid
  bucket        LitPointsBucket
  delta         BigInt
  createdAt     DateTime                   @default(now())
  transaction   LitPointsLedgerTransaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Restrict)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([userId, bucket])
  @@index([userId, createdAt, id])
}

model FinancialHold {
  id                           String                   @id @default(uuid()) @db.Uuid
  sellerProfileId              String                   @db.Uuid
  paymentId                    String?                  @db.Uuid
  orderId                      String?                  @db.Uuid
  ledgerTransactionId          String?                  @unique @db.Uuid
  releaseLedgerTransactionId   String?                  @unique @db.Uuid
  sellerReleasePolicyVersionId String?                  @db.Uuid
  sellerReleasePolicyRuleId    String?                  @db.Uuid
  releaseDelayHours            Int?
  releasePolicyAppliedAt       DateTime?
  amountMinor                  BigInt
  currency                     String                   @default("BRL")
  reason                       FinancialHoldReason
  status                       FinancialHoldStatus      @default(ACTIVE)
  releaseEligibleAt            DateTime?
  releasedAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  sellerProfile                SellerProfile            @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  payment                      Payment?                 @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict)
  order                        Order?                   @relation(fields: [orderId, sellerProfileId], references: [id, sellerProfileId], onDelete: Restrict)
  ledgerTransaction            LedgerTransaction?       @relation("FinancialHoldOriginatingTransaction", fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  releaseLedgerTransaction     LedgerTransaction?       @relation("FinancialHoldReleaseTransaction", fields: [releaseLedgerTransactionId], references: [id], onDelete: Restrict)
  sellerReleasePolicyRule      SellerReleasePolicyRule? @relation(fields: [sellerReleasePolicyRuleId, sellerReleasePolicyVersionId], references: [id, policyVersionId], onDelete: Restrict)

  @@index([orderId, reason])
}

/// Non-monetary completion marker for the valid full-commission case only.
model SellerPendingHoldZero {
  orderId         String        @id @db.Uuid
  paymentId       String        @unique @db.Uuid
  sellerProfileId String        @db.Uuid
  completedAt     DateTime      @default(now())
  order           Order         @relation(fields: [orderId, sellerProfileId], references: [id, sellerProfileId], onDelete: Restrict)
  payment         Payment       @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@unique([orderId, sellerProfileId])
  @@unique([paymentId, orderId])
  @@index([sellerProfileId])
}

model Settlement {
  id                   String           @id @default(uuid()) @db.Uuid
  paymentId            String           @db.Uuid
  amountMinor          BigInt
  currency             String           @default("BRL")
  status               SettlementStatus @default(PENDING)
  externalSettlementId String?
  availableAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  payment              Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Transfer {
  id                 String         @id @default(uuid()) @db.Uuid
  providerCode       String
  externalTransferId String?
  amountMinor        BigInt
  currency           String         @default("BRL")
  status             TransferStatus @default(CREATED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  withdrawal         Withdrawal?

  @@unique([providerCode, externalTransferId])
}

model Withdrawal {
  id                  String                  @id @default(uuid()) @db.Uuid
  sellerProfileId     String                  @db.Uuid
  speed               WithdrawalSpeed         @default(STANDARD)
  approvalMode        WithdrawalApprovalMode  @default(MANUAL)
  debitAmountMinor    BigInt
  feeAmountMinor      BigInt                  @default(0)
  payoutAmountMinor   BigInt
  currency            String                  @default("BRL")
  status              WithdrawalStatus        @default(REQUESTED)
  slaDueAt            DateTime
  requestedAt         DateTime                @default(now())
  reviewedAt          DateTime?
  reviewedByUserId    String?                 @db.Uuid
  rejectionReasonCode String?
  approvedAt          DateTime?
  processingAt        DateTime?
  completedAt         DateTime?
  providerAccountId   String?                 @db.Uuid
  transferId          String?                 @unique @db.Uuid
  destinationRef      String
  idempotencyKeyHash  String                  @unique
  requestHash         String
  failureCode         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sellerProfile       SellerProfile           @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  reviewedBy          User?                   @relation("WithdrawalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  providerAccount     PaymentProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)
  transfer            Transfer?               @relation(fields: [transferId], references: [id], onDelete: Restrict)
}

model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  paymentId          String       @db.Uuid
  orderId            String       @db.Uuid
  amountMinor        BigInt
  currency           String       @default("BRL")
  status             RefundStatus @default(REQUESTED)
  reasonCode         String
  requestedByUserId  String?      @db.Uuid
  providerCode       String?
  externalRefundId   String?
  idempotencyKeyHash String       @unique
  requestHash        String
  requestedAt        DateTime     @default(now())
  processingAt       DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  payment            Payment      @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict)
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy        User?        @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([providerCode, externalRefundId])
  @@index([orderId, status])
}

model Chargeback {
  id                   String           @id @default(uuid()) @db.Uuid
  paymentId            String           @db.Uuid
  amountMinor          BigInt
  currency             String           @default("BRL")
  status               ChargebackStatus @default(OPEN)
  providerCode         String?
  externalChargebackId String?
  openedAt             DateTime         @default(now())
  closedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  payment              Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([providerCode, externalChargebackId])
}

model ProviderWebhookEvent {
  id                      String                     @id @default(uuid()) @db.Uuid
  providerCode            String
  externalEventId         String
  eventType               String
  externalPaymentId       String
  normalizedPaymentStatus ProviderPaymentStatus
  occurredAt              DateTime?
  payloadHash             String
  status                  ProviderWebhookEventStatus @default(RECEIVED)
  attempts                Int                        @default(0)
  availableAt             DateTime                   @default(now())
  receivedAt              DateTime                   @default(now())
  processingStartedAt     DateTime?
  processedAt             DateTime?
  lastErrorCode           String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([providerCode, externalEventId])
  @@index([status, availableAt, receivedAt])
}

model ProviderNotificationInbox {
  id                  String                          @id @default(uuid()) @db.Uuid
  providerCode        String
  notificationKind    ProviderNotificationKind
  contentType         String
  payloadHash         String
  protectedKeyId      String
  protectedVersion    Int
  protectedIv         Bytes
  protectedCiphertext Bytes
  protectedAuthTag    Bytes
  status              ProviderNotificationInboxStatus @default(PENDING)
  attempts            Int                             @default(0)
  availableAt         DateTime                        @default(now())
  receivedAt          DateTime                        @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastErrorCode       String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([status, availableAt, receivedAt])
  @@index([providerCode, payloadHash])
}

model ReconciliationIssue {
  id                  String                    @id @default(uuid()) @db.Uuid
  providerCode        String?
  type                ReconciliationIssueType
  status              ReconciliationIssueStatus @default(OPEN)
  referenceType       String?
  referenceId         String?
  expectedAmountMinor BigInt?
  observedAmountMinor BigInt?
  currency            String                    @default("BRL")
  details             Json                      @default("{}")
  resolvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model FinancialEvent {
  id                  String                @id @default(uuid()) @db.Uuid
  ledgerTransactionId String                @unique @db.Uuid
  type                String
  aggregateType       String
  aggregateId         String
  actorUserId         String?               @db.Uuid
  metadata            Json                  @default("{}")
  createdAt           DateTime              @default(now())
  ledgerTransaction   LedgerTransaction     @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  actor               User?                 @relation("FinancialEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  outbox              FinancialOutboxEvent?
}

model FinancialOutboxEvent {
  id               String                @id @default(uuid()) @db.Uuid
  financialEventId String                @unique @db.Uuid
  eventType        String
  payload          Json
  status           FinancialOutboxStatus @default(PENDING)
  attempts         Int                   @default(0)
  availableAt      DateTime              @default(now())
  publishedAt      DateTime?
  lastErrorCode    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  financialEvent   FinancialEvent        @relation(fields: [financialEventId], references: [id], onDelete: Restrict)
}

model FeePolicyVersion {
  id                         String                      @id @default(uuid()) @db.Uuid
  publicVersion              Int                         @unique
  status                     FeePolicyStatus             @default(DRAFT)
  effectiveFrom              DateTime
  effectiveTo                DateTime?
  createdByUserId            String                      @db.Uuid
  publishedByUserId          String?                     @db.Uuid
  publishedAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  rules                      FeeRule[]
  orders                     Order[]
  orderFeeComponentSnapshots OrderFeeComponentSnapshot[]
  createdBy                  User                        @relation("FeePolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy                User?                       @relation("FeePolicyPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
}

model FeeRule {
  id                         String                      @id @default(uuid()) @db.Uuid
  policyVersionId            String                      @db.Uuid
  category                   FeeRuleCategory
  code                       String
  formula                    FeeFormula
  partyCharged               FeeParty
  percentBps                 Int?
  fixedAmountMinor           BigInt?
  minimumAmountMinor         BigInt?
  maximumAmountMinor         BigInt?
  paymentMethod              PaymentMethod?
  installmentsFrom           Int?
  installmentsTo             Int?
  sellerLevel                String?
  sellerPlan                 String?
  buyerVipPlan               BuyerVipPlan?
  promotionTier              String?
  withdrawalSpeed            WithdrawalSpeed?
  productType                CatalogProductType?
  priority                   Int                         @default(0)
  enabled                    Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  policyVersion              FeePolicyVersion            @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  commissionOrders           Order[]                     @relation("OrderPlatformCommissionRule")
  orderFeeComponentSnapshots OrderFeeComponentSnapshot[]

  @@unique([policyVersionId, code])
  @@unique([id, policyVersionId])
}

model WithdrawalPolicyVersion {
  id                String                 @id @default(uuid()) @db.Uuid
  publicVersion     Int                    @unique
  status            WithdrawalPolicyStatus @default(DRAFT)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdByUserId   String                 @db.Uuid
  publishedByUserId String?                @db.Uuid
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  rules             WithdrawalPolicyRule[]
  createdBy         User                   @relation("WithdrawalPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy       User?                  @relation("WithdrawalPolicyPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
}

model WithdrawalPolicyRule {
  id                  String                  @id @default(uuid()) @db.Uuid
  policyVersionId     String                  @db.Uuid
  speed               WithdrawalSpeed
  enabled             Boolean
  slaHours            Int
  approvalMode        WithdrawalApprovalMode
  feeFormula          FeeFormula              @default(FIXED)
  feePercentBps       Int?
  feeFixedAmountMinor BigInt                  @default(0)
  createdAt           DateTime                @default(now())
  policyVersion       WithdrawalPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([policyVersionId, speed])
}

model SellerReleasePolicyVersion {
  id                String                    @id @default(uuid()) @db.Uuid
  publicVersion     Int                       @unique
  status            SellerReleasePolicyStatus @default(DRAFT)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdByUserId   String                    @db.Uuid
  publishedByUserId String?                   @db.Uuid
  publishedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  rules             SellerReleasePolicyRule[]
  orders            Order[]
  createdBy         User                      @relation("SellerReleasePolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy       User?                     @relation("SellerReleasePolicyPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
}

model SellerReleasePolicyRule {
  id              String                     @id @default(uuid()) @db.Uuid
  policyVersionId String                     @db.Uuid
  code            String
  delayHours      Int
  enabled         Boolean                    @default(true)
  scope           SellerReleasePolicyScope   @default(DEFAULT)
  categoryId      String?                    @db.Uuid
  subcategoryId   String?                    @db.Uuid
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  policyVersion   SellerReleasePolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  category        CatalogCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory     CatalogSubcategory?        @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  financialHolds  FinancialHold[]
  orders          Order[]

  @@unique([id, policyVersionId])
  @@unique([policyVersionId, code])
}
